# Conexão com o PostgreSQL do docker-compose.yml (usuário, senha e banco locais de desenvolvimento)
DATABASE_URL="postgresql://passe:passe@localhost:5433/passe?schema=public"

# Porta HTTP da API (origem: http://localhost:3000; prefixo /api/v1)
PORT=3000

# Origens do frontend liberadas no CORS, separadas por vírgula (nunca "*")
CORS_ORIGIN="http://localhost:5173"
